# Python artifacts
__pycache__/
src/__pycache__/

# Local-only tooling stays out of the repo. Ignoring a whole directory that
# also holds tracked files is a trap -- `git add` skips new files in it without
# a word, which is how scripts/checkRoster.js was lost -- so name what belongs
# instead of ignoring the directory outright.
scripts/*
!scripts/checkRoster.js
tools/

# docs/ is tracked markdown (npm run docs regenerates the hierarchies).
# Anything else dropped in there stays local.
docs/*
!docs/*.md

# Local utility JS files (exclude if unused or dev-only)
toggleView.cjs
updateStats.js
uploadPlayersToFirebase.js
validatePlayersJson.js
GeminiPatchPrompt.md
repomix-output-TradeMachine.xml
repomix-output.xmlTradeMachine.xml
